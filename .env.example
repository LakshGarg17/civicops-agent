# Google Gemini API Key
# Get a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model identifier (e.g., gemini-2.0-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-2.0-flash

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
BACKEND_SERVICE_URL=http://localhost:8000

# Google Cloud Platform Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
FIRESTORE_DATABASE=(default)
GCS_BUCKET=civicops-documents-bucket

# Google Cloud Tasks Configuration
CLOUD_TASKS_QUEUE=civicops-monitoring-queue
CLOUD_TASKS_LOCATION=us-central1

# Local Storage Fallback & Upload Configuration
UPLOAD_DIR=backend/uploads
MAX_FILE_SIZE_MB=10

